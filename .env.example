# Copy to `.env` and adjust. All keys are prefixed with GEOLENS_.
# `.env` is git-ignored; this template is committed.

# Path to the extracted MSLS train_val root (or a .zip archive).
# License-gated: obtain from https://www.mapillary.com/dataset/places
GEOLENS_MSLS_RAW_DIR=

# Target cities for the MVP: the official MSLS-val split (Copenhagen + San
# Francisco). Comma-separated.
GEOLENS_TARGET_CITIES=cph,sf

# Retrieval defaults.
GEOLENS_DEFAULT_TOP_K=5

# Placeholder confidence threshold - calibrated empirically in Sprint S5.
GEOLENS_CONFIDENCE_THRESHOLD=0.5

# API upload boundary (megabytes).
GEOLENS_MAX_UPLOAD_MB=10
